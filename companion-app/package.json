{
  "name": "commission-manager-companion",
  "version": "1.8.0",
  "description": "Companion app for Commission Manager — publishes artwork to multiple platforms",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --dir",
    "build:dir": "electron-builder --win --dir"
  },
  "keywords": [],
  "author": "woundzengberg",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "axios": "^1.19.0",
    "dotenv": "^16.4.0",
    "electron-store": "^8.2.0",
    "form-data": "^4.0.0",
    "playwright": "^1.62.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^22.14.13"
  },
  "build": {
    "appId": "com.commissionmanager.companion",
    "productName": "Commission Manager Companion",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "electronDist": null
  }
}
